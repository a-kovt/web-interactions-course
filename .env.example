# Copy as .env (cp .env.example .env); docker compose reads it. Every value has the same default
# in compose.yaml, so a missing .env changes nothing.

# Published ports (README.md); change if a port is busy and update checks.yaml.
NGINX_PORT=8080
APP_A_PORT=8001
APP_B_PORT=8002
GATEWAY_A_PORT=8091
GATEWAY_B_PORT=8092
SIM_PORT=8090
FLAGS_PORT=8099
POSTGRES_PORT=5432
KAFKA_HOST_PORT=9094
KAFKA_UI_PORT=8085
REDIS_PORT=6379
JAEGER_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# The web client runs outside Compose on this origin (CORS, Origin of WebSocket).
CLIENT_ORIGIN=http://localhost:8081

# Database limits (D2.6): instances x POOL_SIZE + other processes < PG_MAX_CONNECTIONS.
PG_MAX_CONNECTIONS=100
POOL_SIZE=10

# Experiment modes; the skeleton reads them in server/app/config.py.
INVARIANT_MODE=protected
RATE_LIMIT_PER_MIN=120
JWT_REVOCATION=on
OTEL_ENABLED=off

# The simulator of your card (tools/external-sim/README.md).
SIM_NAME=courier
SIM_ROUTE=/deliveries
SIM_DELAY_MS=1000-8000
SIM_REJECT_SHARE=0.2
SIM_ERROR_SHARE=0.05
SIM_REJECT_REASONS="кур'єр не встигає до закриття філії|філія на санітарному дні"
SIM_SEED=

# Lab 6: stop migrations after this version (empty - all); image tags of the versions.
MIGRATE_TO=
APP_TAG=dev
CANARY_TAG=dev
CANARY_WEIGHT=0
